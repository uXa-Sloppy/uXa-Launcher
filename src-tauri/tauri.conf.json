{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "uXa Launcher",
  "version": "0.3.7",
  "identifier": "pro.undeadlegion.uxa.launcher",
  "mainBinaryName": "uxa-launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "uXa Launcher",
        "width": 1280,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "backgroundColor": "#101210"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "uXa",
    "homepage": "https://www.undeadlegion.pro/",
    "shortDescription": "uXa guild game launcher",
    "longDescription": "Install, patch, and launch games for the uXa gaming guild.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
